# Copie este arquivo para ".env" (mesma pasta) e cole sua chave real.
# Nunca coloque a chave real neste arquivo .env.example nem em nenhum
# arquivo que você for enviar para o GitHub.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Porta em que o servidor vai rodar (a maioria dos provedores de hospedagem
# define essa variável automaticamente — não mexa se for o caso).
PORT=3000
